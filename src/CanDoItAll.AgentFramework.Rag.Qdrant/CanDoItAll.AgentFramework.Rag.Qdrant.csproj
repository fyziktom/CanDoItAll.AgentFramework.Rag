<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CanDoItAll.AgentFramework.Rag.Qdrant</AssemblyName>
    <RootNamespace>CanDoItAll.AgentFramework.Rag.Qdrant</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CanDoItAll.AgentFramework.Rag.Qdrant</PackageId>
    <Description>Qdrant provider implementation for the CanDoItAll provider-neutral RAG driver contracts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>CanDoItAll;RAG;Qdrant;vector-database;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Qdrant.Client" Version="1.18.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.AgentFramework.Rag.Driver\CanDoItAll.AgentFramework.Rag.Driver.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CanDoItAll.AgentFramework.Rag.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
