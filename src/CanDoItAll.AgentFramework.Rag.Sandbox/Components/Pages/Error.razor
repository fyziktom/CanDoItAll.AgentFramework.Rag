@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageScaffold>
    <Header>
        <PageHeader Eyebrow="RAG sandbox"
                    Title="Something went wrong"
                    Description="The sandbox could not complete the request."
                    Compact="true" />
    </Header>
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
            <Alert AlertStyle="AlertStyle.Danger">
                An unexpected error occurred while processing the request.
            </Alert>

            @if (ShowRequestId)
            {
                <SectionCard Title="Request details">
                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <TextBlock TextStyle="TextStyle.Note" Value="Request ID" />
                        <StatusBadge Text="@(RequestId!)" Tone="neutral" />
                    </Cluster>
                </SectionCard>
            }

            <SectionCard Title="Local debugging"
                         Description="Detailed errors should remain limited to a local development environment.">
                <TextBlock TextStyle="TextStyle.Body2"
                           Value="Set ASPNETCORE_ENVIRONMENT to Development locally, then restart the sandbox. Do not expose development exception details in a deployed application." />
            </SectionCard>
        </Stack>
    </ChildContent>
</PageScaffold>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
