<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CanDoItAll.AgentFramework.Rag.Driver</AssemblyName>
    <RootNamespace>CanDoItAll.AgentFramework.Rag.Driver</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>CanDoItAll.AgentFramework.Rag.Driver</PackageId>
    <Description>Provider-neutral RAG driver contracts, models, factory composition, and embedding abstractions for CanDoItAll applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>CanDoItAll;RAG;retrieval;vector-database;agents</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
